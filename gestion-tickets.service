[Unit]
Description=Gestión de Tickets - CEDIR
After=network.target postgresql.service

[Service]
Type=simple
User=july
Group=july
WorkingDirectory=/home/july/Desarrollos/Gestión-tickets

# Cargar variables de entorno desde .env
EnvironmentFile=/home/july/Desarrollos/Gestión-tickets/.env

# Crear directorio de logs antes de iniciar
ExecStartPre=/bin/mkdir -p /home/july/Desarrollos/Gestión-tickets/logs

ExecStart=/home/july/Desarrollos/Gestión-tickets/run.sh

Restart=always
RestartSec=10
TimeoutStartSec=30

# Logs del servicio
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
